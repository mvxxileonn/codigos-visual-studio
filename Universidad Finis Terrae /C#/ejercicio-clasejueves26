using System;

class Program
{
    static double AreaCirculo(double radio) => Math.PI * Math.Pow(radio, 2);
    static double PerimetroCirculo(double radio) => 2 * Math.PI * radio;
    static double AreaRectangulo(double baseRect, double altura) => baseRect * altura;
    static double PerimetroRectangulo(double baseRect, double altura) => 2 * (baseRect + altura);

    static void Main()
    {
        // EJERCICIO DE METODOS
        Console.WriteLine("Ingrese el radio del circulo: ");
        double radio = double.Parse(Console.ReadLine());
        Console.WriteLine($"El area del circulo es: {AreaCirculo(radio)}");
        Console.WriteLine($"El perimetro del circulo es: {PerimetroCirculo(radio)}");

        Console.WriteLine("Ingrese la base del rectangulo: ");
        double baseRect = double.Parse(Console.ReadLine());
        Console.WriteLine("Ingrese la altura del rectangulo: ");
        double altura = double.Parse(Console.ReadLine());
        Console.WriteLine($"El area del rectangulo es: {AreaRectangulo(baseRect, altura)}");
        Console.WriteLine($"El perimetro del rectangulo es: {PerimetroRectangulo(baseRect, altura)}");

        // EJERCICIO DE ARRAYS
        int N;
        do
        {
            Console.WriteLine("Ingrese tamaño del arreglo (5 a 7): ");
            N = int.Parse(Console.ReadLine());
        } while (N < 5 || N > 7);

        int[] energia = new int[N];

        for (int i = 0; i < N; i++)
        {
            do
            {
                Console.WriteLine($"Ingrese el valor entre 50 y 150: ");
                energia[i] = int.Parse(Console.ReadLine());
            } while (energia[i] < 50 || energia[i] > 150);
        }

        Console.WriteLine("Valores del arreglo: ");
        for (int i = 0; i < N; i++)
        {
            Console.WriteLine(energia[i]);
        }

        int suma = 0;
        for (int i = 0; i < N; i++)
        {
            suma += energia[i];
        }
        double promedio = (double)suma / N;
        Console.WriteLine($"El promedio es: {promedio}");

        int minimo = energia[0];
        for (int i = 1; i < N; i++)
        {
            if (energia[i] < minimo)
            {
                minimo = energia[i];
            }
        }
        Console.WriteLine($"El valor mínimo es: {minimo}");

        for (int i = 0; i < N; i++)
        {
            if (energia[i] < promedio)
            {
                energia[i] = (int)promedio;
            }
        }

        Console.WriteLine("Valores del arreglo modificado: ");
        for (int i = 0; i < N; i++)
        {
            Console.WriteLine(energia[i]);
        }
    }
}

