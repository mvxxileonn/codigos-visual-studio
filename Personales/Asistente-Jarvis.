<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment-with-locales.min.js"></script>
<script>
moment.locale('es');

const state = {
  active: false,
  clapCount: 0,
  lastClap: 0,
  clapTimeout: null,
  connectors: { spotify: true, calendar: true, email: true, weather: true },
  conversationHistory: [],
  weather: { temp: 18, desc: 'Parcialmente nublado', humidity: 62, wind: 12 },
  spotify: { track: 'Starboy', artist: 'The Weeknd' },
  calendar: [
    { time: '09:00', name: 'Reunión de equipo', loc: 'Sala B · Google Meet' },
    { time: '12:30', name: 'Almuerzo con cliente', loc: 'Av. Providencia 1234' },
    { time: '15:00', name: 'Revisión de proyecto', loc: 'Zoom' }
  ],
  emails: [
    { from: 'Ana García', subject: 'Re: Propuesta Q3 — adjunto el documento final', when: 'HACE 12 MIN' },
    { from: 'GitHub', subject: '[pull request] feat: nueva integración de pagos', when: 'HACE 1 H' },
    { from: 'Carlos Ruiz', subject: '¿Podemos mover la reunión al jueves?', when: 'HACE 2 H' }
  ]
};

function toggleChip(name) {
  state.connectors[name] = !state.connectors[name];
  const el = document.getElementById('chip-' + name);
  el.classList.toggle('on', state.connectors[name]);
}

function showClapFeedback(msg) {
  const el = document.getElementById('clap-feedback');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 1200);
}

function activate() {
  state.active = true;
  document.getElementById('wake-hint').style.display = 'none';
  document.getElementById('core').classList.add('active');
  const d = document.getElementById('main-display');
  d.classList.add('visible');
  if (state.connectors.weather) loadWeather();
  if (state.connectors.calendar) loadCalendar();
  if (state.connectors.email) loadEmail();
  if (state.connectors.spotify) loadSpotify();
  updateClock();
  showClapFeedback('JARVIS ACTIVADO');
}

function deactivate() {
  state.active = false;
  document.getElementById('core').classList.remove('active');
  document.getElementById('main-display').classList.remove('visible');
  document.getElementById('wake-hint').style.display = 'block';
  showClapFeedback('SISTEMA EN ESPERA');
}

function handleClap() {
  const now = Date.now();
  if (now - state.lastClap < 800) {
    state.clapCount++;
    if (state.clapCount >= 2) {
      state.clapCount = 0;
      if (state.active) deactivate();
      else activate();
    }
  } else {
    state.clapCount = 1;
    showClapFeedback('PULSO 1 DETECTADO...');
  }
  state.lastClap = now;
  clearTimeout(state.clapTimeout);
  state.clapTimeout = setTimeout(() => { state.clapCount = 0; }, 900);
}

let audioCtx = null;
let analyser = null;
let dataArray = null;
let clapCooldown = false;

async function initAudio() {
  try {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
    const source = audioCtx.createMediaStreamSource(stream);
    analyser = audioCtx.createAnalyser();
    analyser.fftSize = 256;
    dataArray = new Uint8Array(analyser.frequencyBinCount);
    source.connect(analyser);
    detectClap();
  } catch (e) {
    document.getElementById('wake-hint').textContent = '// CLIC EN PANTALLA PARA ACTIVAR //';
    document.getElementById('wake-hint').style.cursor = 'pointer';
    document.getElementById('wake-hint').onclick = () => {
      if (state.active) deactivate(); else activate();
    };
  }
}

function detectClap() {
  analyser.getByteFrequencyData(dataArray);
  const avg = dataArray.reduce((a, b) => a + b, 0) / dataArray.length;
  if (avg > 32 && !clapCooldown) {
    clapCooldown = true;
    handleClap();
    setTimeout(() => clapCooldown = false, 200);
  }
  requestAnimationFrame(detectClap);
}

document.addEventListener('DOMContentLoaded', () => {
  const btn = document.createElement('button');
  btn.style.cssText = 'position:fixed;bottom:16px;right:16px;background:rgba(0,212,255,0.1);border:1px solid rgba(0,212,255,0.3);color:#00d4ff;font-family:Orbitron,monospace;font-size:9px;padding:8px 14px;cursor:pointer;letter-spacing:2px;border-radius:2px;z-index:99';
  btn.textContent = 'INIT MIC';
  btn.onclick = () => { initAudio(); btn.remove(); };
  document.body.appendChild(btn);
});

function updateClock() {
  document.getElementById('clock').textContent = moment().format('HH:mm:ss');
  setTimeout(updateClock, 1000);
}

async function loadWeather() {
  if (!state.connectors.weather) return;
  try {
    const r = await fetch('https://api.open-meteo.com/v1/forecast?latitude=-33.45&longitude=-70.67&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code&timezone=America/Santiago');
    const d = await r.json();
    const c = d.current;
    state.weather.temp = Math.round(c.temperature_2m);
    state.weather.humidity = c.relative_humidity_2m;
    state.weather.wind = Math.round(c.wind_speed_10m);
    const wc = c.weather_code;
    state.weather.desc = wc <= 1 ? 'Despejado' : wc <= 3 ? 'Parcialmente nublado' : wc <= 48 ? 'Nublado / neblina' : wc <= 67 ? 'Lluvia' : 'Condiciones variables';
    document.getElementById('w-temp').textContent = state.weather.temp + '°C';
    document.getElementById('w-desc').textContent = state.weather.desc;
    document.getElementById('w-extra').textContent = 'Humedad ' + state.weather.humidity + '% · Viento ' + state.weather.wind + ' km/h';
  } catch (e) {}
}

function loadCalendar() {
  if (!state.connectors.calendar) return;
  const panel = document.getElementById('calendar-panel');
  panel.style.display = state.connectors.calendar ? '' : 'none';
}

function loadEmail() {
  const panel = document.getElementById('email-panel');
  panel.style.display = state.connectors.email ? '' : 'none';
}

function loadSpotify() {
  const panel = document.getElementById('spotify-panel');
  panel.style.display = state.connectors.spotify ? '' : 'none';
}

function buildSystemPrompt() {
  const parts = ['Eres JARVIS, el asistente de IA del usuario. Eres conciso, inteligente, algo solemne pero con personalidad. Responde siempre en español. Máximo 3 oraciones.'];
  if (state.connectors.weather) parts.push(`Clima actual en Santiago: ${state.weather.temp}°C, ${state.weather.desc}, humedad ${state.weather.humidity}%, viento ${state.weather.wind} km/h.`);
  if (state.connectors.spotify) parts.push(`Reproduciendo: "${state.spotify.track}" de ${state.spotify.artist}.`);
  if (state.connectors.calendar) {
    const evs = state.calendar.map(e => `${e.time} ${e.name} (${e.loc})`).join('; ');
    parts.push(`Agenda de hoy: ${evs}.`);
  }
  if (state.connectors.email) {
    const em = state.emails.map(e => `De: ${e.from} — ${e.subject}`).join('; ');
    parts.push(`Correos recientes: ${em}.`);
  }
  return parts.join(' ');
}

async function askJarvis() {
  const input = document.getElementById('user-input');
  const q = input.value.trim();
  if (!q) return;
  input.value = '';

  const rp = document.getElementById('response-panel');
  rp.classList.add('visible');
  rp.innerHTML = '<div class="typing"><span></span><span></span><span></span></div>';

  state.conversationHistory.push({ role: 'user', content: q });

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: buildSystemPrompt(),
        messages: state.conversationHistory
      })
    });
    const data = await res.json();
    const reply = data.content?.[0]?.text || 'Sistema no disponible.';
    state.conversationHistory.push({ role: 'assistant', content: reply });
    rp.textContent = reply;
  } catch (e) {
    rp.textContent = 'Fallo en la conexión con el núcleo de IA.';
  }
}

document.addEventListener('keydown', e => {
  if (e.key === 'Enter' && document.activeElement === document.getElementById('user-input')) askJarvis();
});
</script>
