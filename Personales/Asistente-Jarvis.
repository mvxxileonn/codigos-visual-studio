<!DOCTYPE html>
<html>
<head>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: #000;
    color: #00d4ff;
    font-family: 'Rajdhani', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  #app {
    min-height: 100vh;
    background: radial-gradient(ellipse at 50% 0%, #001a2e 0%, #000 70%);
    position: relative;
    padding: 20px;
  }

  #app::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      repeating-linear-gradient(0deg, transparent, transparent 49px, rgba(0,212,255,0.03) 50px),
      repeating-linear-gradient(90deg, transparent, transparent 49px, rgba(0,212,255,0.03) 50px);
    pointer-events: none;
  }

  .hud-ring {
    position: relative;
    width: 220px;
    height: 220px;
    margin: 0 auto 10px;
  }

  .ring-svg {
    width: 100%;
    height: 100%;
    animation: ring-rotate 8s linear infinite;
  }

  @keyframes ring-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .ring-inner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 1px solid rgba(0,212,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    cursor: pointer;
    transition: all 0.3s;
  }

  .ring-inner.active {
    border-color: rgba(0,212,255,0.8);
    box-shadow: 0 0 30px rgba(0,212,255,0.4), inset 0 0 30px rgba(0,212,255,0.1);
  }

  .jarvis-logo {
    font-family: 'Orbitron', monospace;
    font-size: 28px;
    font-weight: 900;
    color: #00d4ff;
    text-shadow: 0 0 20px rgba(0,212,255,0.8);
    letter-spacing: 4px;
  }

  .jarvis-sub {
    font-size: 10px;
    color: rgba(0,212,255,0.5);
    letter-spacing: 3px;
    margin-top: 4px;
  }

  .status-bar {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin: 8px 0 16px;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(0,212,255,0.5);
  }

  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00d4ff;
    margin-right: 6px;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  #main-display {
    display: none;
    animation: fadeIn 0.5s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  #main-display.visible { display: block; }

  .section-title {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    color: rgba(0,212,255,0.5);
    border-bottom: 1px solid rgba(0,212,255,0.15);
    padding-bottom: 6px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 12px;
  }

  .hud-panel {
    background: rgba(0,212,255,0.04);
    border: 1px solid rgba(0,212,255,0.15);
    border-radius: 4px;
    padding: 14px;
    position: relative;
    overflow: hidden;
  }

  .hud-panel::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,212,255,0.4), transparent);
  }

  .hud-panel .panel-icon {
    font-size: 22px;
    color: rgba(0,212,255,0.7);
    margin-bottom: 8px;
  }

  .panel-label {
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(0,212,255,0.4);
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .panel-value {
    font-size: 15px;
    font-weight: 600;
    color: #00d4ff;
    line-height: 1.3;
  }

  .panel-sub {
    font-size: 12px;
    color: rgba(0,212,255,0.5);
    margin-top: 4px;
  }

  .weather-temp {
    font-family: 'Orbitron', monospace;
    font-size: 36px;
    font-weight: 700;
    color: #00d4ff;
  }

  .track-bar {
    height: 2px;
    background: rgba(0,212,255,0.1);
    border-radius: 1px;
    margin-top: 10px;
    overflow: hidden;
  }

  .track-fill {
    height: 100%;
    background: #00d4ff;
    width: 35%;
    animation: play-fill 4s linear infinite;
  }

  @keyframes play-fill {
    from { width: 0%; }
    to { width: 100%; }
  }

  .event-item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 8px 0;
    border-bottom: 1px solid rgba(0,212,255,0.08);
  }

  .event-item:last-child { border-bottom: none; }

  .event-time {
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    color: rgba(0,212,255,0.5);
    min-width: 44px;
    padding-top: 2px;
  }

  .event-name {
    font-size: 13px;
    color: rgba(0,212,255,0.9);
  }

  .event-loc {
    font-size: 11px;
    color: rgba(0,212,255,0.4);
    margin-top: 2px;
  }

  .email-item {
    padding: 8px 0;
    border-bottom: 1px solid rgba(0,212,255,0.08);
  }

  .email-item:last-child { border-bottom: none; }

  .email-sender {
    font-size: 12px;
    font-weight: 600;
    color: #00d4ff;
  }

  .email-subject {
    font-size: 12px;
    color: rgba(0,212,255,0.7);
    margin-top: 2px;
  }

  .email-time {
    font-size: 10px;
    color: rgba(0,212,255,0.35);
    margin-top: 2px;
    letter-spacing: 1px;
  }

  .assistant-bar {
    margin-top: 12px;
    border: 1px solid rgba(0,212,255,0.2);
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: rgba(0,212,255,0.04);
  }

  .assistant-bar input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #00d4ff;
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
    letter-spacing: 1px;
  }

  .assistant-bar input::placeholder {
    color: rgba(0,212,255,0.3);
  }

  .send-btn {
    background: rgba(0,212,255,0.1);
    border: 1px solid rgba(0,212,255,0.3);
    color: #00d4ff;
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    padding: 6px 12px;
    cursor: pointer;
    letter-spacing: 2px;
    border-radius: 2px;
    transition: all 0.2s;
  }

  .send-btn:hover {
    background: rgba(0,212,255,0.2);
    box-shadow: 0 0 10px rgba(0,212,255,0.3);
  }

  .response-panel {
    margin-top: 10px;
    padding: 12px 14px;
    background: rgba(0,212,255,0.03);
    border: 1px solid rgba(0,212,255,0.1);
    border-radius: 4px;
    font-size: 13px;
    color: rgba(0,212,255,0.8);
    line-height: 1.6;
    min-height: 50px;
    display: none;
  }

  .response-panel.visible { display: block; }

  .typing span {
    display: inline-block;
    width: 6px; height: 6px;
    background: #00d4ff;
    border-radius: 50%;
    margin-right: 3px;
    animation: typing 1s infinite;
  }
  .typing span:nth-child(2) { animation-delay: 0.15s; }
  .typing span:nth-child(3) { animation-delay: 0.3s; }

  @keyframes typing {
    0%, 100% { opacity: 0.2; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(-4px); }
  }

  .wake-hint {
    text-align: center;
    font-size: 11px;
    color: rgba(0,212,255,0.3);
    letter-spacing: 2px;
    margin-top: 10px;
    animation: blink 2s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.1; }
  }

  .scan-line {
    position: fixed;
    top: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(0,212,255,0.6), transparent);
    animation: scan 3s linear infinite;
    pointer-events: none;
  }

  @keyframes scan {
    from { top: -2px; }
    to { top: 100vh; }
  }

  .clap-feedback {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,212,255,0.1);
    border: 1px solid rgba(0,212,255,0.4);
    color: #00d4ff;
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    letter-spacing: 3px;
    padding: 8px 20px;
    border-radius: 2px;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
    z-index: 100;
  }

  .clap-feedback.show { opacity: 1; }

  .connect-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }

  .chip {
    font-size: 10px;
    letter-spacing: 1.5px;
    padding: 4px 10px;
    border-radius: 2px;
    border: 1px solid;
    cursor: pointer;
    font-family: 'Orbitron', monospace;
    transition: all 0.2s;
  }

  .chip.spotify { border-color: #1db954; color: #1db954; }
  .chip.spotify.on { background: rgba(29,185,84,0.15); }
  .chip.calendar { border-color: #4285f4; color: #4285f4; }
  .chip.calendar.on { background: rgba(66,133,244,0.15); }
  .chip.email { border-color: #ea4335; color: #ea4335; }
  .chip.email.on { background: rgba(234,67,53,0.15); }
  .chip.weather { border-color: #fbbc05; color: #fbbc05; }
  .chip.weather.on { background: rgba(251,188,5,0.15); }

  .loading-bar {
    height: 2px;
    background: rgba(0,212,255,0.1);
    margin: 6px 0 12px;
    border-radius: 1px;
    overflow: hidden;
  }

  .loading-bar-fill {
    height: 100%;
    background: #00d4ff;
    width: 0%;
    transition: width 1.5s ease;
  }

  .grid-3 { grid-template-columns: 1fr 1fr 1fr; }

  .metric-num {
    font-family: 'Orbitron', monospace;
    font-size: 22px;
    font-weight: 700;
    color: #00d4ff;
  }
</style>
</head>
<body>
