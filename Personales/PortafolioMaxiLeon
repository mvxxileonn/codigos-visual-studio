<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --red:#e31c1c;
  --red2:#ff4444;
  --bg:#000;
  --surface:rgba(18,18,18,0.85);
  --border:rgba(255,255,255,0.08);
  --border2:rgba(255,255,255,0.15);
  --text:#fff;
  --muted:#999;
  --subtle:#555;
}
html{scroll-behavior:smooth}
body{background:#000;color:#fff;font-family:'DM Sans',sans-serif;overflow-x:hidden}

/* CANVAS */
#bg{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:16px 40px;display:flex;justify-content:space-between;align-items:center;backdrop-filter:blur(20px);background:rgba(0,0,0,0.7);border-bottom:1px solid var(--border)}
.nav-logo{font-family:'Syne',sans-serif;font-weight:800;font-size:20px;background:linear-gradient(135deg,var(--red),var(--red2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
nav ul{list-style:none;display:flex;gap:28px}
nav a{font-size:13px;color:var(--muted);text-decoration:none;transition:color .2s}
nav a:hover{color:#fff}

/* MAIN */
main{position:relative;z-index:1}
.container{max-width:820px;margin:0 auto;padding:0 28px}

/* HERO */
.hero{min-height:100vh;display:flex;align-items:center;padding:120px 0 80px}
.hero-inner{position:relative}

.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--red);margin-bottom:20px;font-weight:500}
.hero-eyebrow::before{content:'';display:block;width:20px;height:1px;background:var(--red)}

.hero h1{font-family:'Syne',sans-serif;font-size:clamp(44px,7vw,80px);font-weight:800;line-height:1.0;letter-spacing:-.04em;margin-bottom:24px}
.hero h1 .dim{color:rgba(255,255,255,0.25)}

.hero-desc{font-size:17px;line-height:1.8;color:var(--muted);max-width:540px;margin-bottom:32px;font-weight:300}
.hero-desc strong{color:#fff;font-weight:500}

.hero-meta{display:flex;gap:20px;flex-wrap:wrap;margin-bottom:32px}
.meta-pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--subtle);padding:5px 12px;border:1px solid var(--border);border-radius:20px;background:rgba(255,255,255,0.03)}

.tags{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:36px}
.tag{font-size:12px;padding:5px 13px;border-radius:20px;border:1px solid var(--border2);color:var(--muted);background:rgba(255,255,255,0.03);transition:all .2s}
.tag:hover,.tag.red{border-color:rgba(227,28,28,.4);color:var(--red);background:rgba(227,28,28,.08)}

.btn-row{display:flex;gap:10px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:7px;padding:11px 22px;border-radius:8px;font-size:14px;font-weight:500;text-decoration:none;transition:all .2s;cursor:pointer;border:none;font-family:'DM Sans',sans-serif}
.btn-red{background:var(--red);color:#fff;box-shadow:0 0 28px rgba(227,28,28,.4)}
.btn-red:hover{background:#ff3333;box-shadow:0 0 40px rgba(227,28,28,.6);transform:translateY(-2px)}
.btn-ghost{background:transparent;color:var(--muted);border:1px solid var(--border2)}
.btn-ghost:hover{color:#fff;background:rgba(255,255,255,.05);transform:translateY(-2px)}

/* FLOATING CARD 3D effect */
.card-3d{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:16px;
  padding:28px;
  transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;
  transform-style:preserve-3d;
  will-change:transform;
  cursor:default;
  backdrop-filter:blur(12px);
}
.card-3d:hover{
  border-color:rgba(227,28,28,.3);
  box-shadow:0 20px 60px rgba(227,28,28,.12),0 0 0 1px rgba(227,28,28,.15);
}
.card-3d .card-shine{
  position:absolute;inset:0;border-radius:16px;
  background:radial-gradient(circle at 50% 50%, rgba(255,255,255,.04) 0%, transparent 60%);
  pointer-events:none;transition:opacity .3s;opacity:0;
}
.card-3d:hover .card-shine{opacity:1}

/* SECTIONS */
section{padding:80px 0;border-top:1px solid var(--border)}
.section-label{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--subtle);margin-bottom:40px;display:flex;align-items:center;gap:12px}
.section-label::after{content:'';flex:1;height:1px;background:var(--border)}

/* EDU */
.edu-list{display:flex;flex-direction:column;gap:12px}
.edu-card{position:relative;overflow:hidden;padding-left:28px}
.edu-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:2px;background:var(--border2)}
.edu-card.current::before{background:var(--red)}
.edu-card.prev::before{background:#cc2222}
.edu-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:4px}
.edu-head h3{font-family:'Syne',sans-serif;font-size:16px;font-weight:700;letter-spacing:-.01em}
.edu-period{font-size:11px;color:var(--subtle);padding:3px 9px;border:1px solid var(--border);border-radius:20px;white-space:nowrap}
.edu-inst{font-size:13px;color:var(--muted);margin-bottom:4px}
.edu-note{font-size:12px;color:var(--subtle);line-height:1.6;margin-top:8px;font-style:italic}
.badge-status{display:inline-block;font-size:11px;padding:2px 9px;border-radius:20px;margin-top:8px;background:rgba(227,28,28,.12);color:var(--red);border:1px solid rgba(227,28,28,.25);font-weight:500}

/* CERTS */
.certs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:12px}
.cert-card{position:relative;overflow:hidden}
.cert-icon{font-size:22px;margin-bottom:12px;display:block}
.cert-name{font-size:14px;font-weight:500;line-height:1.35;margin-bottom:5px}
.cert-issuer{font-size:12px;color:var(--muted);margin-bottom:3px}
.cert-date{font-size:11px;color:var(--subtle)}

/* INTERESTS */
.int-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}
.int-card{position:relative;overflow:hidden}
.int-icon{font-size:26px;margin-bottom:10px;display:block}
.int-name{font-size:14px;font-weight:500;margin-bottom:4px}
.int-desc{font-size:12px;color:var(--subtle);line-height:1.5}

/* FOOTER */
footer{padding:40px 0;border-top:1px solid var(--border);text-align:center;position:relative;z-index:1}
.footer-name{font-family:'Syne',sans-serif;font-size:13px;color:var(--subtle);margin-bottom:10px}
.footer-links{display:flex;justify-content:center;gap:20px;flex-wrap:wrap}
.footer-links a{font-size:12px;color:var(--subtle);text-decoration:none;transition:color .2s}
.footer-links a:hover{color:var(--red)}
.sep{color:var(--border2)}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.fade-up{opacity:0;animation:fadeUp .7s ease forwards}
.delay-1{animation-delay:.1s}.delay-2{animation-delay:.2s}.delay-3{animation-delay:.3s}
.delay-4{animation-delay:.4s}.delay-5{animation-delay:.5s}.delay-6{animation-delay:.6s}

@keyframes scroll-appear{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.appear{opacity:0}
.appear.visible{animation:scroll-appear .6s ease forwards}

@media(max-width:600px){
  nav ul{display:none}
  nav{padding:14px 20px}
  .hero{padding:100px 0 60px}
  .certs-grid,.int-grid{grid-template-columns:1fr 1fr}
}
</style>
