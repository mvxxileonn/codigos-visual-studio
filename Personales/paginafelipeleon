<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Felipe León</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,700;1,400&family=Cormorant+Garamond:wght@300;400;500;600&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --black: #060c18;
    --dark: #0b1525;
    --card: #0f1e35;
    --card2: #112040;
    --white: #e8eef8;
    --gray: #7a9abf;
    --light-gray: #9ab8d8;
    --accent: #2a6fc9;
    --accent2: #4d9ee8;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--white);
    font-family: 'Montserrat', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 60px;
    background: transparent;
  }

  nav a {
    color: var(--white);
    text-decoration: none;
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
    transition: opacity 0.2s;
  }
  nav a:hover { opacity: 1; }

  .nav-left { display: flex; gap: 28px; }
  .nav-center { font-family: 'Montserrat', sans-serif; font-size: 13px; letter-spacing: 0.22em; font-weight: 500; }
  .nav-right { display: flex; gap: 28px; }

  /* ── HERO ── */
  #hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10,25,60,0.5) 0%,
      rgba(8,18,45,0.6) 40%,
      rgba(6,12,24,0.92) 100%
    ),
    url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1800&q=80') center/cover no-repeat;
  }

  .hero-name {
    position: relative;
    font-family: 'EB Garamond', serif;
    font-size: clamp(72px, 12vw, 180px);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-align: center;
    color: var(--white);
    opacity: 0.92;
    line-height: 1;
    user-select: none;
  }

  .hero-arrow {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 22px;
    opacity: 0.6;
    animation: bounce 2s ease-in-out infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ── SECTIONS GENERAL ── */
  section {
    padding: 100px 60px;
  }

  /* ── ABOUT ── */
  #about {
    background: var(--dark);
    padding: 80px 40px;
  }

  .about-card {
    background: var(--card);
    border-radius: 20px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 100px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    min-height: 500px;
  }

  .about-text h2 {
    font-family: 'EB Garamond', serif;
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 400;
    margin-bottom: 32px;
    line-height: 1.1;
  }

  .about-text p {
    font-size: 14px;
    line-height: 1.85;
    color: #ccc;
    font-weight: 300;
  }

  .about-img-wrap {
    position: relative;
    display: flex;
    justify-content: flex-end;
  }

  .about-img {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: 16px;
    filter: grayscale(20%);
    transform: rotate(2deg);
  }

  .about-img-placeholder {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 3/4;
    background: linear-gradient(135deg, #0f2040 0%, #1a3560 50%, #0a1830 100%);
    border-radius: 16px;
    transform: rotate(2deg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    color: var(--gray);
    font-size: 13px;
    letter-spacing: 0.1em;
  }

  .about-img-placeholder svg {
    width: 48px; height: 48px; opacity: 0.3;
  }

  /* ── EARLY LIFE ── */
  #early-life {
    background: var(--dark);
    padding: 80px 40px;
  }

  .early-card {
    background: var(--card);
    border-radius: 20px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 100px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    min-height: 600px;
  }

  .early-text h2 {
    font-family: 'EB Garamond', serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    margin-bottom: 32px;
    line-height: 1.1;
  }

  .early-text p {
    font-size: 14px;
    line-height: 1.85;
    color: #ccc;
    font-weight: 300;
    margin-bottom: 24px;
  }

  .early-img-stack {
    position: relative;
    height: 500px;
  }

  .early-img-1, .early-img-2 {
    position: absolute;
    border-radius: 12px;
    object-fit: cover;
  }

  .early-placeholder-1 {
    position: absolute;
    width: 68%;
    height: 55%;
    bottom: 0; right: 0;
    background: linear-gradient(135deg, #112040, #0a1830);
    border-radius: 12px;
    transform: rotate(-3deg);
    display: flex; align-items: center; justify-content: center;
    color: var(--gray); font-size: 12px; letter-spacing: 0.08em;
  }

  .early-placeholder-2 {
    position: absolute;
    width: 55%;
    height: 45%;
    top: 20px; right: 25%;
    background: linear-gradient(135deg, #1a3560, #112040);
    border-radius: 12px;
    transform: rotate(4deg);
    display: flex; align-items: center; justify-content: center;
    color: var(--gray); font-size: 12px; letter-spacing: 0.08em;
  }

  /* ── Trayectoria ── */
  #empresas {
    background: var(--black);
    text-align: center;
  }

  #empresas h2 {
    font-family: 'EB Garamond', serif;
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 400;
    margin-bottom: 64px;
  }

  .empresas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .empresa-card {
    background: var(--card);
    border-radius: 16px;
    padding: 40px 32px;
    text-align: left;
    transition: transform 0.3s ease;
  }
  .empresa-card:hover { transform: translateY(-6px); }

  .empresa-icon {
    font-size: 28px;
    margin-bottom: 20px;
  }

  .empresa-card h3 {
    font-family: 'EB Garamond', serif;
    font-size: 22px;
    font-weight: 500;
    margin-bottom: 12px;
  }

  .empresa-card p {
    font-size: 13px;
    line-height: 1.7;
    color: var(--gray);
  }

  /* ── CONTACT ── */
  #contact {
    background: var(--black);
    text-align: center;
    padding: 120px 60px;
  }

  #contact h2 {
    font-family: 'EB Garamond', serif;
    font-size: clamp(48px, 7vw, 100px);
    font-weight: 400;
    margin-bottom: 60px;
    line-height: 1.05;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-bottom: 80px;
  }

  .social-links a {
    color: var(--white);
    opacity: 0.75;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
  }
  .social-links a:hover { opacity: 1; }

  .social-links svg {
    width: 26px; height: 26px;
    fill: currentColor;
  }

  .contact-footer-img {
    max-width: 1100px;
    margin: 0 auto;
    border-radius: 20px;
    overflow: hidden;
    height: 340px;
    background: linear-gradient(to bottom, #1a1a1a, #111);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 40px;
    position: relative;
  }

  .contact-figure {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 220px;
    background: linear-gradient(to top, #2a2a2a, #111);
    border-radius: 60px 60px 0 0;
    opacity: 0.4;
  }

  .contact-tagline {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--gray);
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--black); }
  ::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }

  /* ── FADE IN ON SCROLL ── */
  .fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    nav { padding: 20px 24px; }
    .nav-left, .nav-right { display: none; }
    .about-card, .early-card { grid-template-columns: 1fr; padding: 40px 28px; gap: 40px; }
    .about-img-wrap { justify-content: center; }
    .early-img-stack { height: 300px; }
    section { padding: 60px 20px; }
    #about, #early-life { padding: 40px 20px; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-left">
    <a href="#about">Acerca de</a>
    <a href="#early-life">Vida temprana</a>
  </div>
  <div class="nav-center">
    <a href="#hero">FELIPE LEÓN</a>
  </div>
  <div class="nav-right">
    <a href="#empresas">Logros</a>
    <a href="#contact">Contacto</a>
  </div>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="hero-bg"></div>
  <h1 class="hero-name">FELIPE LEÓN</h1>
  <div class="hero-arrow">&#8964;</div>
</section>

<!-- ABOUT -->
<section id="about">
  <div class="about-card fade-in">
    <div class="about-text">
      <h2>Acerca de</h2>
      <p>
        Felipe Arturo León Alfaro es un joven líder chileno, estudiante, comunicador y agente de cambio social. Con tan solo 20 años, combina una sólida formación académica con un compromiso genuino por el liderazgo juvenil, los valores y el servicio a la comunidad.
      </p>
      <br>
      <p>
        Miembro activo del Global Shapers Hub Santiago del Foro Económico Mundial, donde desde 2025 se desempeña como Officer de Comunicaciones. Es católico practicante con una visión conservadora, entendida desde el compromiso con los valores, la responsabilidad cívica y el servicio al bien común.
      </p>
    </div>
    <div class="about-img-wrap">
      <div class="about-img-placeholder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
        <span style="font-size:11px;letter-spacing:0.12em;opacity:0.5;">FELIPE LEÓN</span>
      </div>
    </div>
  </div>
</section>

<!-- EARLY LIFE -->
<section id="early-life">
  <div class="early-card fade-in">
    <div class="early-text">
      <h2>Primeros años de vida</h2>
      <p>
        Felipe nació el 3 de junio y creció en el seno de una familia numerosa, tanto por parte materna como paterna, que ha sido un pilar fundamental en su formación personal y valórica.
      </p>
      <p>
        Cursó su educación desde Prekínder hasta la Enseñanza Media en el Liceo Bicentenario Inmaculada Concepción de Cauquenes, donde ingresó en 2010 y egresó en 2023. Posteriormente, obtuvo un título en la Academia de Líderes Católicos de Latinoamérica (Chile).
      </p>
      <p>
        Desde los 10 años es paciente de Artritis Idiopática Juvenil, condición que ha fortalecido su carácter y resiliencia. Durante su etapa escolar participó activamente en la directiva de curso, la pastoral juvenil, el Centro General de Estudiantes y diversas campañas solidarias.
      </p>
      <p>
        Es un apasionado de la Fórmula 1 y mantiene un profundo interés por el liderazgo y el compromiso social.
      </p>
    </div>
    <div class="early-img-stack">
      <div class="early-placeholder-2">Infancia</div>
      <div class="early-placeholder-1">Juventud</div>
    </div>
  </div>
</section>

<!-- LOGROS / EMPRESAS -->
<section id="empresas">
  <h2 class="fade-in">Logros & Proyectos</h2>
  <div class="empresas-grid">
    <div class="empresa-card fade-in">
      <div class="empresa-icon">🌍</div>
      <h3>Global Shapers Hub</h3>
      <p>Officer de Comunicaciones del Global Shapers Hub Santiago, iniciativa del Foro Económico Mundial. Desde 2025 aporta a la estrategia comunicacional y a la difusión del impacto social del Hub.</p>
    </div>
    <div class="empresa-card fade-in">
      <div class="empresa-icon">📚</div>
      <h3>Academia de Líderes Católicos</h3>
      <p>Titulado de la Academia de Líderes Católicos de Latinoamérica (Chile), formación que profundizó su compromiso con los valores, el servicio comunitario y el liderazgo con visión de fe.</p>
    </div>
    <div class="empresa-card fade-in">
      <div class="empresa-icon">🎓</div>
      <h3>Universidad Finis Terrae</h3>
      <p>Estudiante de Licenciatura en Historia en la Universidad Finis Terrae, Santiago de Chile. Profundiza en el pensamiento histórico y político con una mirada crítica y conservadora.</p>
    </div>
    <div class="empresa-card fade-in">
      <div class="empresa-icon">🤝</div>
      <h3>Liderazgo Estudiantil</h3>
      <p>Durante su etapa escolar fue parte activa de la directiva de curso, la pastoral juvenil y el Centro General de Estudiantes, impulsando campañas solidarias y trabajo comunitario.</p>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <h2 class="fade-in">Ponte en contacto</h2>
  <div class="social-links fade-in">
    <!-- Instagram -->
    <a href="https://www.instagram.com/felipemtleon" target="_blank" aria-label="Instagram">
      <svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.2 4.8 1.7 5 5 .1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.2 3.2-1.7 4.8-5 5-1.3.1-1.6.1-4.9.1s-3.6 0-4.8-.1c-3.3-.2-4.8-1.8-5-5C2.1 15.6 2 15.3 2 12s0-3.6.1-4.8c.2-3.3 1.7-4.8 5-5C8.4 2.2 8.8 2.2 12 2.2zm0-2.2C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.2 4.4 2.6 6.8 7 7C8.3 24 8.7 24 12 24s3.7 0 4.9-.1c4.4-.2 6.8-2.6 7-7C24 15.7 24 15.3 24 12s0-3.7-.1-4.9c-.2-4.3-2.6-6.8-7-7C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4A6.2 6.2 0 0 0 12 5.8zm0 10.2a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8z"/></svg>
    </a>
    <!-- YouTube -->
    <a href="https://www.youtube.com/@felipemtleon_" target="_blank" aria-label="YouTube">
      <svg viewBox="0 0 24 24"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8zM9.7 15.5V8.5l6.3 3.5-6.3 3.5z"/></svg>
    </a>
    <!-- X / Twitter -->
    <a href="https://x.com/felipemtleon_" target="_blank" aria-label="X / Twitter">
      <svg viewBox="0 0 24 24"><path d="M18.2 2h3.4L13.9 10l9 12H15l-5.5-7.2L3.5 22H.1l8.2-9.4L0 2h7.1l5 6.6L18.2 2zm-1.2 18h1.9L7.1 4H5.1L17 20z"/></svg>
    </a>
    <!-- LinkedIn -->
    <a href="https://www.linkedin.com/in/felipe-arturo-le%C3%B3n-alfaro-b14ba01a8/" target="_blank" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24"><path d="M20.4 20.4h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.5v1.6h.1c.5-.9 1.7-1.9 3.4-1.9 3.7 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM3.5 20.4h3.6V9H3.5v11.4zM22.2 0H1.8C.8 0 0 .8 0 1.8v20.4C0 23.2.8 24 1.8 24h20.4c1 0 1.8-.8 1.8-1.8V1.8C24 .8 23.2 0 22.2 0z"/></svg>
    </a>
  </div>

  <div class="contact-footer-img fade-in">
    <div class="contact-figure"></div>
    <p class="contact-tagline">Felipe Arturo León Alfaro &nbsp;·&nbsp; Santiago, Chile</p>
  </div>
</section>

<script>
  // Fade in on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
</script>
</body>
</html>
